{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Keep actions pinned to commit SHAs, with their version in a comment.
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  // Wait a week after a release, like the minimum_release_age of mise.
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',
  postUpdateOptions: ['gomodTidy'],
  packageRules: [
    {
      // The go directive is the oldest Go that dependents need, so it is
      // raised on purpose only. The toolchain directive still updates.
      matchManagers: ['gomod'],
      matchDepTypes: ['golang'],
      enabled: false,
    },
    {
      // Renovate skips indirect requirements unless they have a security
      // advisory it knows, which left the E2E module on a golang.org/x/net
      // with known vulnerabilities. Keep them current like the direct ones.
      matchManagers: ['gomod'],
      matchDepTypes: ['indirect'],
      matchFileNames: ['e2e/**'],
      enabled: true,
    },
    {
      // Patch updates that pass CI need no review.
      matchUpdateTypes: ['patch', 'digest', 'pinDigest'],
      automerge: true,
    },
    {
      // Neither do minor updates of what only the repository uses: the
      // tools, the actions and the E2E module. The library's own
      // dependencies pass on to its users, so they are reviewed.
      matchManagers: ['github-actions', 'mise', 'custom.regex'],
      matchUpdateTypes: ['minor'],
      automerge: true,
    },
    {
      matchFileNames: ['e2e/**'],
      matchUpdateTypes: ['minor'],
      automerge: true,
    },
    {
      // The E2E module is not published, so its updates fix nothing for
      // users.
      matchFileNames: ['e2e/**'],
      semanticCommitType: 'chore',
    },
  ],
  // Security updates skip minimumReleaseAge, which leaves review as the
  // only check against a malicious release posing as a fix.
  vulnerabilityAlerts: {
    automerge: false,
  },
  customManagers: [
    {
      // Tools the workflows run with `go run module/cmd@version`.
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: ['go run golang\\.org/x/vuln/cmd/govulncheck@(?<currentValue>v\\S+)'],
      depNameTemplate: 'golang.org/x/vuln',
      datasourceTemplate: 'go',
    },
  ],
}
